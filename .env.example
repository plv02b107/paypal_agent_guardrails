# Groq LLM
GROQ_API_KEY=your_groq_api_key_here

# Gateway authentication
AGENT_API_TOKEN=replace_with_agent_token
HUMAN_APPROVAL_TOKEN=replace_with_human_approval_token

# Agent-to-gateway connection
GATEWAY_BASE_URL=http://127.0.0.1:8000

# SQLite database
GUARDRAIL_DB_PATH=guardrail_v2.db

# PayPal Sandbox credentials
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret

# PayPal Sandbox API
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Checkout callbacks
PAYPAL_RETURN_URL=http://127.0.0.1:8000/paypal/return
PAYPAL_CANCEL_URL=http://127.0.0.1:8000/paypal/cancel
